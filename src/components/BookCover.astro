---
/**
 * Kapak.
 *
 * Gerçek kapaklar telifli, depoda görsel taşımıyoruz. Yerine kitabın adından
 * türetilen deterministik bir kapak üretiyoruz: aynı kitap her build'de aynı
 * rengi ve aynı harfi alır, böylece kullanıcı kapağı listede "tanır".
 *
 * Kapakta BAŞLIK YOK — başlık zaten kartın altında yazıyor; ikisini birden
 * basmak 143 piksellik kartta gürültü yaratıyordu. Kapak: baş harf + yazar.
 *
 * Gerçek kapak eklemek: `public/covers/<id>.jpg|png|webp` koy, build otomatik bulur.
 */
import { existsSync } from 'node:fs';

interface Props { id: string; title: string; sub?: string; eager?: boolean }
const { id, title, sub = '', eager = false } = Astro.props;

const EXT = ['jpg', 'jpeg', 'png', 'webp', 'avif'];
const slug = id.replace(/[^\w-]/g, '_');
const found = EXT.find(e => existsSync(new URL(`../../public/covers/${slug}.${e}`, import.meta.url)));
const src = found ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/covers/${slug}.${found}` : null;

/** Başlıktan sabit renk (djb2). */
function hash(s: string) {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
  return h;
}
const h = hash(title + id);
const hue = h % 360;
const tilt = (h >> 9) % 2 === 0 ? -3 : 3;      // monogramı hafifçe eğ, kapaklar tekdüze olmasın

/** Baş harf: Latin olmayan başlıklarda (Çince, Rusça) ilk karakteri olduğu gibi al. */
const initial = [...title.replace(/^[^\p{L}\p{N}]+/u, '')][0]?.toLocaleUpperCase('tr') ?? '?';
const author = sub.length > 30 ? sub.slice(0, 28).trimEnd() + '…' : sub;
---
{src ? (
  <img class="cover cover--photo" src={src} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="143" height="214" />
) : (
  <span class="cover cover--gen" style={`--h:${hue};--tilt:${tilt}deg`} aria-hidden="true">
    <span class="cover__band"></span>
    <span class="cover__mark">{initial}</span>
    {author && <span class="cover__sub">{author}</span>}
  </span>
)}
