---
/**
 * Kapak. İki katman:
 *
 *   1. Altta her zaman üretilen kapak — kitabın adından türeyen sabit renk,
 *      baş harf monogramı ve yazar. Ağ gerektirmez, hiç boş kalmaz.
 *   2. Üstte varsa gerçek kapak görseli (Open Library). Yüklenemezse görsel
 *      kendini siler ve alttaki kapak görünür; yer değiştirme (layout shift) olmaz.
 *
 * Kendi kapağını koymak istersen `public/covers/<id>.jpg|png|webp` her ikisini de ezer.
 */
import { existsSync } from 'node:fs';

interface Props { id: string; title: string; sub?: string; coverId?: number | null; eager?: boolean }
const { id, title, sub = '', coverId = null, eager = false } = Astro.props;

const EXT = ['jpg', 'jpeg', 'png', 'webp', 'avif'];
const slug = id.replace(/[^\w-]/g, '_');
const local = EXT.find(e => existsSync(new URL(`../../public/covers/${slug}.${e}`, import.meta.url)));

const src = local
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/covers/${slug}.${local}`
  : coverId
    ? `https://covers.openlibrary.org/b/id/${coverId}-L.jpg`
    : null;

/** Başlıktan sabit renk (djb2). */
function hash(s: string) {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
  return h;
}
const h = hash(title + id);
const hue = h % 360;
const tilt = (h >> 9) % 2 === 0 ? -3 : 3;

/** Baş harf: Latin olmayan başlıklarda (Çince, Rusça, Devanagari) ilk karakter olduğu gibi. */
const initial = [...title.replace(/^[^\p{L}\p{N}]+/u, '')][0]?.toLocaleUpperCase('tr') ?? '?';
const author = sub.length > 30 ? sub.slice(0, 28).trimEnd() + '…' : sub;
---
<span class="cover" style={`--h:${hue};--tilt:${tilt}deg`}>
  <span class="cover__band" aria-hidden="true"></span>
  <span class="cover__mark" aria-hidden="true">{initial}</span>
  {author && <span class="cover__sub" aria-hidden="true">{author}</span>}
  {src && (
    <img
      class="cover--photo"
      src={src}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
    />
  )}
</span>
